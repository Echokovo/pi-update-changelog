{
  "name": "@echokovo/pi-update-changelog",
  "version": "0.1.0",
  "description": "View changelogs and update installed Pi packages interactively.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "index.ts",
    "settings.ts",
    "summary.ts",
    "README.md",
    "demo.gif",
    "demo1.png",
    "demo2.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Echokovo/pi-update-changelog.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/Echokovo/pi-update-changelog/main/demo1.png"
  },
  "scripts": {
    "test": "node --test *.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "check": "npm run typecheck && npm test && npm run pack:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.7",
    "typescript": "^6.0.3"
  },
  "author": "Michael Bøcker-Larsen"
}
